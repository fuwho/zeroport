# Office temp / lock files
~$*
*.tmp

# OS junk
.DS_Store
Thumbs.db

# Node (if a build is ever added)
node_modules/
.vercel/

# ── SECRETS — never commit these ────────────────────────────────────
# hs_ed25519_secret_key IS the onion service's identity. Anyone holding
# it can impersonate the service at that .onion address.
#
# These are path-independent on purpose: the previous rules named
# demo/tor/hs/, and when that directory was renamed the rules silently
# stopped matching while the keys were still on disk. Match by shape,
# not by location.
**/hs_ed25519_secret_key
**/hs_ed25519_public_key
**/hostname
**/torrc
**/tor/data/
**/tor/hs/
*_secret_key
*.conf

# ── Generated at runtime ────────────────────────────────────────────
.runtime/
**/audit-*.log
**/audit-*.log.ots
**/audit-*.log.anchor.json
**/audit-*.log.orig
**/boot.log

# Local working backups — not part of the deliverable
demo-backup-v1/
*.bak
